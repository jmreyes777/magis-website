# ============================================================
# Magis monorepo .gitignore
# ============================================================

# --- Dependencies ---
node_modules/
**/node_modules/

# --- Secrets / environment files (NEVER commit) ---
.env
.env.*
**/.env
**/.env.*
# ...but DO keep example templates
!.env.example
!**/.env.example
# Legacy custom-named env files
backend.env
**/backend.env
!backend.env.example
!**/backend.env.example

# --- Firebase / service-account credentials ---
serviceaccountkey.json
**/serviceaccountkey.json
*serviceaccount*.json
**/*serviceaccount*.json
*service-account*.json
**/*service-account*.json
firebase-adminsdk*.json
**/firebase-adminsdk*.json

# --- Keys / certs ---
*.pem
*.key
*.p12
*.pfx

# --- Build output ---
build/
dist/
**/build/
**/dist/
.cache/

# --- Cloudflare Wrangler ---
.wrangler/
**/.wrangler/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Misc temp ---
*.tmp
**/magis-edge-worker-temp/
