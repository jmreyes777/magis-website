# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# ── Video masters (93MB+ originals stay local; only web-optimized renditions
#    like 30th-anniversary.mp4 are committed) ─────────────────────────────────
/public/videos/*
!/public/videos/30th-anniversary.mp4

# misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment / secrets (NEVER commit these) ────────────────────────────────
.env
.env.*
!.env.example

# ── Local overrides ───────────────────────────────────────────────────────────
.env.local
.env.development.local
.env.test.local
.env.production.local
# Playwright (TST3)
/test-results
/playwright-report
