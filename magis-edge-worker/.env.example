# magis-edge-worker/.env.example - Copy to .env and fill in real values
# NEVER commit .env to git

PORT=4000
EDGE_WORKER_PORT=8787
BACKEND_URL=http://localhost:5000
ADMIN_URL=http://localhost:3001
GUEST_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
JWT_SECRET=replace-with-same-secret-as-backend
# Shared secret injected as the X-Edge-Auth header so the backend trusts geo
# headers only from this worker. Must match EDGE_SHARED_SECRET in the backend.
EDGE_SHARED_SECRET=replace-with-strong-random-secret
COOKIE_DOMAIN=localhost
FB_PAGE_ID=your-facebook-page-id
FB_PAGE_ACCESS_TOKEN=your-facebook-page-access-token