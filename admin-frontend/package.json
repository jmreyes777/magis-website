{
  "name": "admin-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "electron-main.js",
  "proxy": "http://127.0.0.1:8787",
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@simplewebauthn/browser": "^13.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "axios": "^1.18.1",
    "browser-image-compression": "^2.0.2",
    "cra-template": "1.3.0",
    "firebase": "^11.10.0",
    "jwt-decode": "^4.0.0",
    "nosleep.js": "^0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-google-recaptcha": "^3.1.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.7.0",
    "react-multi-date-picker": "^4.5.2",
    "react-multi-select-component": "^4.3.4",
    "react-router-dom": "^7.18.1",
    "react-scripts": "^5.0.1",
    "react-time-picker": "^7.0.0",
    "react-toastify": "^11.1.0",
    "react-weekday-picker": "^1.0.8",
    "recharts": "^3.9.2",
    "socket.io-client": "^4.8.3",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none PORT=3001 react-scripts start\" \"wait-on http://localhost:3001 && cross-env ELECTRON_START_URL=http://localhost:3001 electron .\"",
    "electron:dev": "npm start",
    "electron:staging": "cross-env ELECTRON_START_URL=https://magis-admin-staging.onrender.com electron .",
    "build": "react-scripts build",
    "analyze": "react-scripts build && npx source-map-explorer \"build/static/js/*.js\"",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "globals": {
      "google": "readonly"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "wait-on": "^8.0.3"
  }
}
