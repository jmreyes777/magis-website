# backend.env.example - Copy to backend.env and fill in real values
# NEVER commit backend.env to git

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-hex
JWT_CLOCK_SKEW_SEC=60
JWT_TTL_MIN=30
JWT_ADMIN_TTL_MIN=240
JWT_WORKER_TIMEOUT_MS=10000
# PERF3-1: number of secret worker threads (round-robin pool) backing all JWT
# sign/verify/revoke. The signing secret stays inside the worker threads. 1 =
# legacy single-worker behavior; raise (e.g. 4) to parallelize JWT-bound auth
# under concurrency. `revoke` is broadcast to all workers, so revocation
# semantics are unchanged regardless of pool size.
JWT_WORKER_POOL=4
JWT_REDIS_PREFIX=jwt:revoked:
# P2-1: revocation (force-logout) fail-mode when the Redis store is unreachable.
# false (default) = fail-OPEN: trust the local in-memory set (no lockout risk,
#   but a revocation made on another instance/before a restart may be missed).
# true = fail-CLOSED: REJECT the token when the revocation store is unknown
#   (strongest session security; only enable with HA managed Redis, since a
#   Redis outage will then reject authenticated traffic).
JWT_REVOCATION_FAIL_CLOSED=false
# ── JWT signing algorithm (P2-3: asymmetric migration) ────────────────────────
# HS256 (default) uses the symmetric JWT_SECRET above on BOTH the edge and the
# origin — compromise of either forges tokens for all roles. RS256 uses an
# asymmetric key pair: the origin holds the PRIVATE key (signs), the edge holds
# only the PUBLIC key (verifies), so an edge compromise can no longer mint tokens.
# Generate a key pair with:  node backend/scripts/generate-jwt-keypair.js
JWT_ALG=HS256
# RS256 key pair (PEM with literal \n, exactly like FIREBASE_PRIVATE_KEY).
# Required when JWT_ALG=RS256. Keep JWT_PRIVATE_KEY ONLY on the backend; put
# JWT_PUBLIC_KEY on the backend AND the edge worker.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# During the HS256→RS256 cutover, keep verifying HS256 so tokens issued just
# before the switch still verify. Flip to false once the longest TTL (~4h, the
# admin token) has elapsed — then remove JWT_SECRET from the edge worker.
JWT_ACCEPT_HS256=true
# ── JWT issuer/audience claims (P3-5: cross-role/service replay hardening) ────
# Every token we mint is stamped with an issuer (iss) and a role-derived
# audience (aud); verification can then reject tokens from another issuer/
# deployment or whose audience doesn't match their role.
#   monitor (default) → stamp iss/aud + LOG mismatches, never reject (safe)
#   enforce           → stamp iss/aud + REJECT wrong/missing iss or aud
#   off               → don't check (claims are still stamped in)
# Rollout: deploy with "monitor", then flip to "enforce" only AFTER the longest
# token TTL (branch-admin login = 8h) has elapsed, so pre-rollout tokens (which
# lack the claims) have all expired.
JWT_VERIFY_CLAIMS=monitor
JWT_ISSUER=magis-api
# Role → audience map (must be stable; defaults shown). The edge worker may
# later enforce JWT_AUD_ADMIN on admin routes for defense-in-depth.
JWT_AUD_GUEST=magis-guest
JWT_AUD_ADMIN=magis-admin
JWT_AUD_SUPERADMIN=magis-superadmin
# Fallback audience for tokens with an unrecognized/absent role.
JWT_AUDIENCE=magis-api

# ── Conversation-key encryption (chat key wrapping at rest) ───────────────────
# Wraps each per-conversation AES-256 key before it is written to Firestore
# (collection: conversationKeys). If UNSET, keys are stored UNWRAPPED (plaintext
# at rest) and the backend logs a one-time warning at first use.
# Use a long random value (e.g. 64 hex chars) and keep it DURABLE + BACKED UP:
# if it is lost or changed, any key stored with the "v1:" prefix becomes
# undecryptable and that conversation's history can no longer be read.
# Must be identical across all backends that share the same Firestore.
CONV_KEY_SECRET=replace-with-64-char-random-hex

# ── Redis ─────────────────────────────────────────────────────────────────────
# P2-1: Redis backs CLUSTER-SAFE rate-limiting (login brute-force, guest abuse)
# AND JWT revocation. In production/staging it MUST be a managed/HA instance —
# if REDIS_URL is unset the server falls back to localhost (nothing there) and
# those controls become per-instance/in-memory only (effectively inert). The
# server logs a loud warning at startup when this is missing in prod.
REDIS_URL=redis://127.0.0.1:6379
# P2-1: set true in prod to make the server REFUSE TO START without REDIS_URL,
# guaranteeing rate-limiting/revocation can never silently regress. Default off.
REQUIRE_REDIS=false
REDIS_TLS=false
REDIS_KEY_PREFIX=magis:dev
REDIS_PRESENCE_PREFIX=branch:online:
REDIS_UNDELIVERED_PREFIX=queue:undelivered:
REDIS_SOCKET_RL_PREFIX=rl:socket:guest:
ONLINE_TTL_SEC=90
SOCKET_REDIS_INIT_TIMEOUT_MS=2000

# ── PERF2-1: Redis read-through cache (near-static, NON-SENSITIVE data) ─────────
# Backs utils/cache.js. Caches only non-user-specific metadata (the `branches`
# list/doc); NEVER auth/credential/revocation state or message content. Writes
# invalidate the relevant keys, so TTL is just a backstop. The cache is
# FAIL-OPEN — if Redis is down it transparently falls back to Firestore.
CACHE_PREFIX=cache:
# Per-op timeout (ms). Bounds added latency when Redis is unhealthy.
CACHE_OP_TIMEOUT_MS=200
# Backstop TTL (seconds) for cached `branches` reads (30–300 recommended).
CACHE_BRANCHES_TTL=300
# Kill switch: set true to bypass the cache entirely (always read source).
CACHE_DISABLED=false

# ── PERF2-4: Analytics query bounds (routes/analytics.js) ──────────────────────
# All analytics scans are time-bounded and capped. Counts come from Firestore
# count() aggregation; a capped doc slice feeds the in-Node breakdowns. Responses
# include `truncated:true` when a scan hits the cap.
# Hard cap on documents read per analytics request (safety net).
ANALYTICS_MAX_DOCS=20000
# Default lookback window (days) used only when a request omits a date range
# (the dashboard always sends one, so this is a fallback).
ANALYTICS_DEFAULT_DAYS=90

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SUPPORT_EMAIL=your-email@gmail.com
SUPPORT_EMAIL_PASSWORD=your-app-password

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
REACT_APP_BACKEND_URL=http://localhost:5000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
# P2-4: superadmin login allowlist (comma-separated emails). An email here is
# allowed to log in via POST /api/superadmin/login even without a Firebase
# role:'superadmin' custom claim. If UNSET, a legacy default is used and the
# server logs a warning at boot — set this explicitly to manage superadmins via
# config instead of code.
SUPERADMIN_EMAILS=jmreyes3167@gmail.com

# ── MFA enforcement (A10-1 / P0-2) ───────────────────────────────────────────
# requireMFA (middlewares/requireMFA.js) gates SPI endpoints behind an active
# MFA session. On a TRANSIENT error during the session check (e.g. a Firestore
# blip) it fails OPEN by default so a verified admin is not ejected by an infra
# hiccup. Set false to fail CLOSED (return 503 + retry) — stricter, recommended
# in production once MFA is stable.
MFA_FAIL_OPEN=true

# ── Staff access (password + email-OTP) ──────────────────────────────────────
# Branch chat-dashboard STAFF accounts (super-admin-provisioned) authenticate
# with a password + a 6-digit code emailed at login. This module is ADDITIVE and
# reuses the SMTP/SUPPORT_EMAIL settings above — no new config is REQUIRED.
# All values below are optional tunables with safe defaults.
#
# Secret used to HMAC-hash OTP codes at rest (falls back to JWT_SECRET if unset).
# Set a dedicated long random value in production.
STAFF_OTP_PEPPER=
# OTP lifetime / attempt + resend throttle.
STAFF_OTP_TTL_SEC=600
STAFF_OTP_MAX_ATTEMPTS=5
STAFF_OTP_RESEND_INTERVAL_SEC=45
STAFF_OTP_MAX_SENDS=5
STAFF_OTP_SEND_WINDOW_SEC=900
# Lifetime of the short-lived ticket that binds the password step to the OTP step.
STAFF_OTP_TICKET_TTL_MIN=10
# Password account lockout (failed login attempts -> temporary lock).
STAFF_MAX_FAILED_LOGINS=8
STAFF_LOCKOUT_MINUTES=15
# Minimum length enforced when a staffer sets a new password.
STAFF_MIN_PASSWORD_LEN=10
# Coarse per-IP throttle for /api/staff/login and /api/staff/stepup (Redis-backed).
STAFF_AUTH_RL_MAX=30
# "Remember this device" trust duration (days) before the emailed code is required again.
STAFF_TRUSTED_DEVICE_DAYS=30
# Optional sign-in URL included in credential emails (else ADMIN_FRONTEND_URL).
STAFF_LOGIN_URL=
# Display name used in the "From" of module emails.
MAIL_FROM_NAME=Magis Admin

# ── Edge / origin lock-down (P2-2) ────────────────────────────────────────────
# The Cloudflare edge worker injects `X-Edge-Auth: <EDGE_SHARED_SECRET>` on every
# /api request it proxies. Setting the SAME secret here lets the backend reject
# direct-to-origin traffic that bypasses the edge's JWT/rate/geo controls.
# Generate a long random value (e.g. 64 hex chars) and set the IDENTICAL secret
# on the worker:  wrangler secret put EDGE_SHARED_SECRET
# Leave UNSET to disable the lock (fail-open, backward compatible). Only enforced
# when NODE_ENV=production. (Also used to authenticate forwarded geo headers.)
EDGE_SHARED_SECRET=
# Rollout mode (default: monitor):
#   monitor = LOG non-edge /api requests but allow them (use first to confirm all
#             legitimate traffic carries the header — watch for the 🚧 log line).
#   enforce = 403 any /api request without a valid X-Edge-Auth.
# SAFE ORDER: (1) wrangler secret put EDGE_SHARED_SECRET + redeploy the worker,
# (2) set the same EDGE_SHARED_SECRET here with EDGE_AUTH_MODE=monitor, (3) confirm
# only /health + probes are flagged, (4) flip EDGE_AUTH_MODE=enforce.
EDGE_AUTH_MODE=monitor

# ── Trusted proxy hop count (P3-2) ────────────────────────────────────────────
# Express derives req.ip from X-Forwarded-For based on this. `true` trusts the
# ENTIRE (client-controlled) chain → req.ip is spoofable, letting an attacker
# rotate fake X-Forwarded-For values to evade per-IP rate limits. PIN it to the
# number of trusted reverse-proxy hops in front of Node so the spoofed left-most
# entries are ignored. Cloudflare worker → Render typically = 2; a single proxy
# = 1. Accepts an integer, "false" (disable), or a CSV of trusted IPs/CIDRs.
# To verify: log req.ip for a known client and increase until it matches the real
# client IP (not a Cloudflare/Render egress IP). NOTE: the rate limiters also key
# off the edge-authenticated client IP (X-Edge-Auth + sanitized X-Forwarded-For),
# so this value mainly affects req.ip on untrusted/direct-to-origin fallbacks.
TRUST_PROXY=1

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# P1-4: per-IP throttle on guest-session creation (POST /api/guest/init)
GUEST_INIT_RL_WINDOW_MS=600000
GUEST_INIT_RL_MAX=20
# P1-4: how long after a guest token expires it may still be used to refresh
GUEST_REFRESH_GRACE_MS=2592000000
# P1-5: per-IP throttle on the guest contact relay (POST /api/guest/contact)
GUEST_CONTACT_RL_WINDOW_MS=600000
GUEST_CONTACT_RL_MAX=5
MAX_UPLOAD_MB=15
MAX_MESSAGES_PER_HOUR=100

# ── OAuth2 (Google) ───────────────────────────────────────────────────────────
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret
REDIRECT_URI=http://localhost:5000/oauth2callback
REFRESH_TOKEN=your-refresh-token
GOOGLE_API_KEY=your-google-api-key

# ── reCAPTCHA ─────────────────────────────────────────────────────────────────
REACT_APP_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# ── Cloudflare Turnstile (guest /init bot protection, P1-4 Part B) ────────────
# Backend verifies the guest /init token only when TURNSTILE_SECRET is set
# (graceful no-op otherwise; fails OPEN on verifier outage). Set the secret in
# the backend service env once the guest frontend is deployed.
TURNSTILE_SECRET=your-turnstile-secret-key
# Set to false for MONITOR mode (verify + log, never block) while validating setup:
TURNSTILE_ENFORCE=true
# Public site key embedded in the guest frontend build (has a built-in default):
REACT_APP_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── Facebook ──────────────────────────────────────────────────────────────────
FB_PAGE_ID=your-page-id
FB_PAGE_ACCESS_TOKEN=your-page-access-token

# ── Catalog cutouts: instant refresh (OPTIONAL) ───────────────────────────────
# When set, the backend fires a GitHub repository_dispatch the moment a NEW
# Facebook album becomes the latest, so the off-site cutout job regenerates the
# homepage's transparent jewelry cutouts within minutes (instead of waiting for
# the daily cron). Leave BLANK to keep the daily schedule only — the live server
# never does image processing either way. Token needs `repo` scope (classic PAT)
# or fine-grained Contents:write on the repo below.
GH_DISPATCH_TOKEN=
GH_DISPATCH_REPO=jmreyes777/magis-website

# ── Caddy / TLS (staging + production only) ───────────────────────────────────
ACME_EMAIL=your-email@domain.com

# ── Audit & compliance trail (chat audit dashboard) ───────────────────────────
# Append-only audit log powering /api/audit + the admin "Audit Log" dashboard.
# All values are OPTIONAL with safe defaults; tune for retention/scale.
# Firestore collection name for audit events.
AUDIT_COLLECTION=auditLogs
# Retention: each event stores an `expireAt` = now + this many days. Enable a
# Firestore TTL policy on the `auditLogs.expireAt` field (Firebase console →
# Firestore → TTL) to auto-delete expired events. Compliance default: 365 days.
AUDIT_RETENTION_DAYS=365
# Max docs scanned per audit query (bounded cost; matches beyond this are flagged
# `truncated`), and the default lookback window when no date range is supplied.
AUDIT_MAX_DOCS=5000
AUDIT_DEFAULT_DAYS=90
# Default page size for the events list and the hard row cap on CSV export.
AUDIT_PAGE_DEFAULT=100
AUDIT_EXPORT_MAX=10000