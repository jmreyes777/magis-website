# backend.env.example - Copy to backend.env and fill in real values
# NEVER commit backend.env to git

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-hex
JWT_CLOCK_SKEW_SEC=60
JWT_TTL_MIN=30
JWT_ADMIN_TTL_MIN=240
JWT_WORKER_TIMEOUT_MS=10000
JWT_REDIS_PREFIX=jwt:revoked:
# P2-1: revocation (force-logout) fail-mode when the Redis store is unreachable.
# false (default) = fail-OPEN: trust the local in-memory set (no lockout risk,
#   but a revocation made on another instance/before a restart may be missed).
# true = fail-CLOSED: REJECT the token when the revocation store is unknown
#   (strongest session security; only enable with HA managed Redis, since a
#   Redis outage will then reject authenticated traffic).
JWT_REVOCATION_FAIL_CLOSED=false
# ── JWT signing algorithm (P2-3: asymmetric migration) ────────────────────────
# HS256 (default) uses the symmetric JWT_SECRET above on BOTH the edge and the
# origin — compromise of either forges tokens for all roles. RS256 uses an
# asymmetric key pair: the origin holds the PRIVATE key (signs), the edge holds
# only the PUBLIC key (verifies), so an edge compromise can no longer mint tokens.
# Generate a key pair with:  node backend/scripts/generate-jwt-keypair.js
JWT_ALG=HS256
# RS256 key pair (PEM with literal \n, exactly like FIREBASE_PRIVATE_KEY).
# Required when JWT_ALG=RS256. Keep JWT_PRIVATE_KEY ONLY on the backend; put
# JWT_PUBLIC_KEY on the backend AND the edge worker.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# During the HS256→RS256 cutover, keep verifying HS256 so tokens issued just
# before the switch still verify. Flip to false once the longest TTL (~4h, the
# admin token) has elapsed — then remove JWT_SECRET from the edge worker.
JWT_ACCEPT_HS256=true

# ── Conversation-key encryption (chat key wrapping at rest) ───────────────────
# Wraps each per-conversation AES-256 key before it is written to Firestore
# (collection: conversationKeys). If UNSET, keys are stored UNWRAPPED (plaintext
# at rest) and the backend logs a one-time warning at first use.
# Use a long random value (e.g. 64 hex chars) and keep it DURABLE + BACKED UP:
# if it is lost or changed, any key stored with the "v1:" prefix becomes
# undecryptable and that conversation's history can no longer be read.
# Must be identical across all backends that share the same Firestore.
CONV_KEY_SECRET=replace-with-64-char-random-hex

# ── Redis ─────────────────────────────────────────────────────────────────────
# P2-1: Redis backs CLUSTER-SAFE rate-limiting (login brute-force, guest abuse)
# AND JWT revocation. In production/staging it MUST be a managed/HA instance —
# if REDIS_URL is unset the server falls back to localhost (nothing there) and
# those controls become per-instance/in-memory only (effectively inert). The
# server logs a loud warning at startup when this is missing in prod.
REDIS_URL=redis://127.0.0.1:6379
# P2-1: set true in prod to make the server REFUSE TO START without REDIS_URL,
# guaranteeing rate-limiting/revocation can never silently regress. Default off.
REQUIRE_REDIS=false
REDIS_TLS=false
REDIS_KEY_PREFIX=magis:dev
REDIS_PRESENCE_PREFIX=branch:online:
REDIS_UNDELIVERED_PREFIX=queue:undelivered:
REDIS_SOCKET_RL_PREFIX=rl:socket:guest:
ONLINE_TTL_SEC=90
SOCKET_REDIS_INIT_TIMEOUT_MS=2000

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SUPPORT_EMAIL=your-email@gmail.com
SUPPORT_EMAIL_PASSWORD=your-app-password

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
REACT_APP_BACKEND_URL=http://localhost:5000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Edge / origin lock-down (P2-2) ────────────────────────────────────────────
# The Cloudflare edge worker injects `X-Edge-Auth: <EDGE_SHARED_SECRET>` on every
# /api request it proxies. Setting the SAME secret here lets the backend reject
# direct-to-origin traffic that bypasses the edge's JWT/rate/geo controls.
# Generate a long random value (e.g. 64 hex chars) and set the IDENTICAL secret
# on the worker:  wrangler secret put EDGE_SHARED_SECRET
# Leave UNSET to disable the lock (fail-open, backward compatible). Only enforced
# when NODE_ENV=production. (Also used to authenticate forwarded geo headers.)
EDGE_SHARED_SECRET=
# Rollout mode (default: monitor):
#   monitor = LOG non-edge /api requests but allow them (use first to confirm all
#             legitimate traffic carries the header — watch for the 🚧 log line).
#   enforce = 403 any /api request without a valid X-Edge-Auth.
# SAFE ORDER: (1) wrangler secret put EDGE_SHARED_SECRET + redeploy the worker,
# (2) set the same EDGE_SHARED_SECRET here with EDGE_AUTH_MODE=monitor, (3) confirm
# only /health + probes are flagged, (4) flip EDGE_AUTH_MODE=enforce.
EDGE_AUTH_MODE=monitor

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# P1-4: per-IP throttle on guest-session creation (POST /api/guest/init)
GUEST_INIT_RL_WINDOW_MS=600000
GUEST_INIT_RL_MAX=20
# P1-4: how long after a guest token expires it may still be used to refresh
GUEST_REFRESH_GRACE_MS=2592000000
# P1-5: per-IP throttle on the guest contact relay (POST /api/guest/contact)
GUEST_CONTACT_RL_WINDOW_MS=600000
GUEST_CONTACT_RL_MAX=5
MAX_UPLOAD_MB=15
MAX_MESSAGES_PER_HOUR=100

# ── OAuth2 (Google) ───────────────────────────────────────────────────────────
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret
REDIRECT_URI=http://localhost:5000/oauth2callback
REFRESH_TOKEN=your-refresh-token
GOOGLE_API_KEY=your-google-api-key

# ── reCAPTCHA ─────────────────────────────────────────────────────────────────
REACT_APP_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# ── Cloudflare Turnstile (guest /init bot protection, P1-4 Part B) ────────────
# Backend verifies the guest /init token only when TURNSTILE_SECRET is set
# (graceful no-op otherwise; fails OPEN on verifier outage). Set the secret in
# the backend service env once the guest frontend is deployed.
TURNSTILE_SECRET=your-turnstile-secret-key
# Set to false for MONITOR mode (verify + log, never block) while validating setup:
TURNSTILE_ENFORCE=true
# Public site key embedded in the guest frontend build (has a built-in default):
REACT_APP_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── Facebook ──────────────────────────────────────────────────────────────────
FB_PAGE_ID=your-page-id
FB_PAGE_ACCESS_TOKEN=your-page-access-token

# ── Caddy / TLS (staging + production only) ───────────────────────────────────
ACME_EMAIL=your-email@domain.com